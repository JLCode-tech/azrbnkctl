apiVersion: k8s.cni.cncf.io/v1
kind: NetworkAttachmentDefinition
metadata:
  name: tmm-ext
  namespace: {{ .Namespace }}
spec:
  config: |
    {
      "cniVersion": "0.3.1",
      "name": "tmm-ext",
      "type": "host-device",
      "pciBusID": "{{ .ExtPCI }}"
    }
{{- if .IntPCI }}
---
apiVersion: k8s.cni.cncf.io/v1
kind: NetworkAttachmentDefinition
metadata:
  name: tmm-int
  namespace: {{ .Namespace }}
spec:
  config: |
    {
      "cniVersion": "0.3.1",
      "name": "tmm-int",
      "type": "host-device",
      "pciBusID": "{{ .IntPCI }}"
    }
{{- end }}
