apiVersion: k8s.cni.cncf.io/v1
kind: NetworkAttachmentDefinition
metadata:
  name: tmm-ext
  namespace: {{ .Namespace }}
spec:
  config: |
    {
      "cniVersion": "0.3.1",
      "name": "external-net",
      "type": "bridge",
      "bridge": "br-ext",
      "isGateway": true,
      "ipMasq": false,
      "ipam": {
        "type": "host-local",
        "subnet": "10.0.17.0/24",
        "rangeStart": "10.0.17.200",
        "rangeEnd": "10.0.17.250"
      }
    }
{{- if .IntPCI }}
---
apiVersion: k8s.cni.cncf.io/v1
kind: NetworkAttachmentDefinition
metadata:
  name: tmm-int
  namespace: {{ .Namespace }}
spec:
  config: |
    {
      "cniVersion": "0.3.1",
      "name": "internal-net",
      "type": "bridge",
      "bridge": "br-int",
      "isGateway": true,
      "ipMasq": false,
      "ipam": {
        "type": "host-local",
        "subnet": "10.0.18.0/24",
        "rangeStart": "10.0.18.200",
        "rangeEnd": "10.0.18.250"
      }
    }
{{- end }}

